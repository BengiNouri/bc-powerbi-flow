{
  "name": "LEGO — Akse Demo DW",
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/master/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.137.json",
  "dataColors": [
    "#D01012",
    "#FFCF00",
    "#006DB7",
    "#00AF4D",
    "#FF8C00",
    "#F58384",
    "#997C00",
    "#9CA3AF"
  ],
  "good": "#00AF4D",
  "neutral": "#006DB7",
  "bad": "#FF8C00",
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#D01012",
  "firstLevelElements": "#1A1A1A",
  "secondLevelElements": "#D01012",
  "thirdLevelElements": "#9CA3AF",
  "textClasses": {
    "title": {
      "fontFace": "Inter",
      "fontSize": 24,
      "color": "#D01012"
    },
    "header": {
      "fontFace": "Inter",
      "fontSize": 16,
      "color": "#1A1A1A"
    },
    "label": {
      "fontFace": "Inter",
      "fontSize": 12,
      "color": "#1A1A1A"
    },
    "callout": {
      "fontFace": "Inter",
      "fontSize": 36,
      "color": "#D01012"
    }
  },
  "visualStyles": {
    "card": {
      "*": {
        "labels": [
          {
            "properties": {
              "color": {
                "solid": {
                  "color": "#D01012"
                }
              },
              "fontSize": {
                "expr": {
                  "Literal": {
                    "Value": "36D"
                  }
                }
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "properties": {
              "color": {
                "solid": {
                  "color": "#1A1A1A"
                }
              },
              "fontSize": {
                "expr": {
                  "Literal": {
                    "Value": "12D"
                  }
                }
              }
            }
          }
        ],
        "background": [
          {
            "properties": {
              "show": {
                "expr": {
                  "Literal": {
                    "Value": "true"
                  }
                }
              },
              "color": {
                "solid": {
                  "color": "#FFFFFF"
                }
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "properties": {
              "strokeWidth": {
                "expr": {
                  "Literal": {
                    "Value": "2D"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [
          {
            "properties": {
              "defaultColor": {
                "solid": {
                  "color": "#D01012"
                }
              }
            }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [
          {
            "properties": {
              "defaultColor": {
                "solid": {
                  "color": "#D01012"
                }
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "properties": {
              "position": {
                "expr": {
                  "Literal": {
                    "Value": "'Right'"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "properties": {
              "gridHorizontal": {
                "expr": {
                  "Literal": {
                    "Value": "true"
                  }
                }
              },
              "gridHorizontalColor": {
                "solid": {
                  "color": "#9CA3AF"
                }
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "properties": {
              "backColor": {
                "solid": {
                  "color": "#D01012"
                }
              },
              "fontColor": {
                "solid": {
                  "color": "#FFFFFF"
                }
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "properties": {
              "fontColor": {
                "solid": {
                  "color": "#D01012"
                }
              }
            }
          }
        ],
        "items": [
          {
            "properties": {
              "fontColor": {
                "solid": {
                  "color": "#1A1A1A"
                }
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "properties": {
              "color": {
                "solid": {
                  "color": "#FFFFFF"
                }
              },
              "transparency": {
                "expr": {
                  "Literal": {
                    "Value": "0D"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}