{
  "name": "Coloplast — Power BI theme",
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/master/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.137.json",
  "dataColors": [
    "#003F5C",
    "#00A4E4",
    "#E8F4FA",
    "#3FA34D",
    "#E67E22",
    "#00A7F4",
    "#005A7E",
    "#9CA3AF"
  ],
  "good": "#3FA34D",
  "neutral": "#E8F4FA",
  "bad": "#E67E22",
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#003F5C",
  "firstLevelElements": "#1A1A1A",
  "secondLevelElements": "#003F5C",
  "thirdLevelElements": "#9CA3AF",
  "textClasses": {
    "title": {
      "fontFace": "Inter",
      "fontSize": 24,
      "color": "#003F5C"
    },
    "header": {
      "fontFace": "Inter",
      "fontSize": 16,
      "color": "#1A1A1A"
    },
    "label": {
      "fontFace": "Inter",
      "fontSize": 12,
      "color": "#1A1A1A"
    },
    "callout": {
      "fontFace": "Inter",
      "fontSize": 36,
      "color": "#003F5C"
    }
  },
  "visualStyles": {
    "card": {
      "*": {
        "labels": [
          {
            "properties": {
              "color": {
                "solid": {
                  "color": "#003F5C"
                }
              },
              "fontSize": {
                "expr": {
                  "Literal": {
                    "Value": "36D"
                  }
                }
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "properties": {
              "color": {
                "solid": {
                  "color": "#1A1A1A"
                }
              },
              "fontSize": {
                "expr": {
                  "Literal": {
                    "Value": "12D"
                  }
                }
              }
            }
          }
        ],
        "background": [
          {
            "properties": {
              "show": {
                "expr": {
                  "Literal": {
                    "Value": "true"
                  }
                }
              },
              "color": {
                "solid": {
                  "color": "#FFFFFF"
                }
              }
            }
          }
        ],
        "border": [
          {
            "properties": {
              "show": {
                "expr": {
                  "Literal": {
                    "Value": "true"
                  }
                }
              },
              "color": {
                "solid": {
                  "color": "#9CA3AF"
                }
              },
              "radius": {
                "expr": {
                  "Literal": {
                    "Value": "4D"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "properties": {
              "strokeWidth": {
                "expr": {
                  "Literal": {
                    "Value": "2D"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [
          {
            "properties": {
              "defaultColor": {
                "solid": {
                  "color": "#003F5C"
                }
              }
            }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [
          {
            "properties": {
              "defaultColor": {
                "solid": {
                  "color": "#003F5C"
                }
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "properties": {
              "position": {
                "expr": {
                  "Literal": {
                    "Value": "'Right'"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "properties": {
              "gridHorizontal": {
                "expr": {
                  "Literal": {
                    "Value": "true"
                  }
                }
              },
              "gridHorizontalColor": {
                "solid": {
                  "color": "#9CA3AF"
                }
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "properties": {
              "backColor": {
                "solid": {
                  "color": "#003F5C"
                }
              },
              "fontColor": {
                "solid": {
                  "color": "#FFFFFF"
                }
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "properties": {
              "fontColor": {
                "solid": {
                  "color": "#003F5C"
                }
              }
            }
          }
        ],
        "items": [
          {
            "properties": {
              "fontColor": {
                "solid": {
                  "color": "#1A1A1A"
                }
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "properties": {
              "color": {
                "solid": {
                  "color": "#FFFFFF"
                }
              },
              "transparency": {
                "expr": {
                  "Literal": {
                    "Value": "0D"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}