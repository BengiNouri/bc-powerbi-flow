# ───────────────────────────────────────────────────────────
# Source database / API credentials
# Set SOURCE_TYPE to ONE of: postgres | mssql | bc_odata | csv_folder
# ───────────────────────────────────────────────────────────

SOURCE_TYPE=postgres

# --- PostgreSQL / Supabase ---
PG_HOST=db.<project-ref>.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=<password>
PG_SCHEMA=public
PG_SSLMODE=require

# --- MS SQL (BC SaaS / Dynamics / on-prem) ---
MSSQL_SERVER=tcp:server.database.windows.net,1433
MSSQL_DATABASE=<db_name>
MSSQL_USER=<user>
MSSQL_PASSWORD=<password>
MSSQL_TRUST=no

# --- Business Central OData v4 ---
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0/<tenant>/<env>/ODataV4/Company('<company>')
BC_USER=<oauth_user_or_basic>
BC_PASSWORD=<oauth_token_or_pwd>

# --- CSV folder fallback ---
CSV_FOLDER=./input

# ───────────────────────────────────────────────────────────
# Supabase staging (Phase 3)
# ───────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>

# ───────────────────────────────────────────────────────────
# Fabric workspace + Lakehouse (Phase 4)
# ───────────────────────────────────────────────────────────
FABRIC_WORKSPACE_ID=<guid>
FABRIC_LAKEHOUSE_ID=<guid>
