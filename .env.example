# ───────────────────────────────────────────────────────────
# Source database / API credentials
# Set SOURCE_TYPE to ONE of: postgres | mssql | bc_odata | csv_folder
# ───────────────────────────────────────────────────────────

SOURCE_TYPE=postgres

# --- PostgreSQL / Supabase ---
PG_HOST=db.<project-ref>.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=<password>
PG_SCHEMA=public
PG_SSLMODE=require

# --- MS SQL (BC SaaS / Dynamics / on-prem) ---
MSSQL_SERVER=tcp:server.database.windows.net,1433
MSSQL_DATABASE=<db_name>
MSSQL_USER=<user>
MSSQL_PASSWORD=<password>
MSSQL_TRUST=no

# --- Business Central OData v4 (OAuth — BC SaaS) ---
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0/<tenant-guid>/<env>/ODataV4/Company('<company>')
BC_TENANT_ID=<azure_ad_tenant_guid>
BC_CLIENT_ID=<app_registration_client_id>
BC_CLIENT_SECRET=<app_registration_secret>

# --- Business Central OData v4 (Basic — on-prem fallback) ---
# Leave BC_TENANT_ID unset to use these
# BC_USER=<user>
# BC_PASSWORD=<web_service_access_key>

# --- HubSpot Private App token ---
# Create at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_TOKEN=pat-eu1-<token>

# --- CSV folder fallback ---
CSV_FOLDER=./input

# --- Scan options ---
# SCAN_NO_COUNTS=1   # skip row-counting on large tables (faster initial scan)

# ───────────────────────────────────────────────────────────
# Supabase staging (Phase 3)
# ───────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>

# ───────────────────────────────────────────────────────────
# Fabric workspace + Lakehouse (Phase 4)
# ───────────────────────────────────────────────────────────
FABRIC_WORKSPACE_ID=<guid>
FABRIC_LAKEHOUSE_ID=<guid>
